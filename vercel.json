{
  "buildCommand": "uv pip install --system -r requirements.txt",
  "outputDirectory": "api",
  "installCommand": "uv pip install --system -r requirements.txt",
  "framework": null,
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/app.py"
    },
    {
      "src": "/feed/(.*)",
      "dest": "/api/app.py"
    },
    {
      "src": "/(.*)",
      "dest": "/api/app.py"
    }
  ]
}